# Multi-stage build for AgentMeter Service
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Build the service
RUN npm run build:service

# Production stage
FROM node:20-alpine AS production

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create app directory and user
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && \
    adduser -S agentmeter -u 1001

# Copy package files and install production dependencies
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && \
    yarn cache clean

# Copy built application from builder stage
COPY --from=builder --chown=agentmeter:nodejs /app/static ./static

# Copy service configuration files
COPY --chown=agentmeter:nodejs service/config ./service/config

# Create logs directory
RUN mkdir -p logs && chown agentmeter:nodejs logs

# Switch to non-root user
USER agentmeter

# Expose port
EXPOSE 4021

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4021/health', (res) => { \
    process.exit(res.statusCode === 200 ? 0 : 1) \
  }).on('error', () => process.exit(1))"

# Start the service
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "static/service.js"] 