# Multi-stage build for AgentMeter Frontend
FROM node:18-alpine AS base

# Install security updates and essential packages
RUN apk update && apk upgrade && \
    apk add --no-cache \
    dumb-init \
    nginx \
    gettext \
    wget \
    && rm -rf /var/cache/apk/*

# Create app directory and user
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production && npm cache clean --force

# Copy built frontend
COPY static/ ./static/

# Copy nginx configuration template
COPY deployment/configs/nginx.conf /app/nginx.conf.template

# Build metadata
ARG COMMIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG ENVIRONMENT=production

ENV COMMIT_SHA=${COMMIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}
ENV ENVIRONMENT=${ENVIRONMENT}
ENV NODE_ENV=production

# Set up nginx directories and permissions
RUN mkdir -p /app/nginx /app/logs /app/cache /app/tmp/client_body /app/tmp/proxy /app/tmp/fastcgi /app/tmp/uwsgi /app/tmp/scgi && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

USER nextjs

# Expose port
EXPOSE 8080

# Create startup script
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'export PORT=${PORT:-8080}' >> /app/start.sh && \
    echo 'envsubst "\$PORT" < /app/nginx.conf.template > /app/nginx.conf' >> /app/start.sh && \
    echo 'exec nginx -c /app/nginx.conf -g "daemon off;"' >> /app/start.sh && \
    chmod +x /app/start.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-8080}/ || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start with our script
CMD ["/app/start.sh"] 